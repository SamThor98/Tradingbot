# Core runtime
DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/tradingbot
REDIS_URL=redis://localhost:6379/0

# Security/auth
CREDENTIAL_ENCRYPTION_KEY=replace_with_urlsafe_base64_32byte_key
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret
SUPABASE_JWT_SECRET_LEGACY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
WEB_ALLOWED_ORIGINS=https://your-frontend.example.com
WEB_INTERNAL_API_KEY=replace_with_internal_metrics_key

# Billing
SAAS_BILLING_ENFORCE=0
SAAS_ENABLE_STRIPE_WEBHOOK=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# Schwab dual-app OAuth
SCHWAB_MARKET_APP_KEY=
SCHWAB_MARKET_APP_SECRET=
SCHWAB_ACCOUNT_APP_KEY=
SCHWAB_ACCOUNT_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/
SCHWAB_MARKET_CALLBACK_URL=https://127.0.0.1:8182/

# SEC EDGAR fair-access contact. Placeholder example.com addresses are rejected.
# EDGAR_USER_AGENT=YourCompanyName you@yourdomain.com

# Deployment/migrations
SAAS_HEALTH_REQUIRE_REDIS=1
SAAS_HEALTH_REQUIRE_WORKERS=1
SAAS_RUN_ALEMBIC=1
SAAS_BOOTSTRAP_SCHEMA=0
SAAS_DISABLE_PLATFORM_MARKET_FALLBACK=0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
CELERY_WORKER_POOL=solo
CELERY_WORKER_CONCURRENCY=

# Liquid (xyz perp) positioning overlay — shadow-first, read-only, never execution
LIQUID_OVERLAY_MODE=shadow
LIQUID_COLLECT_ENABLED=false
LIQUID_DEX=xyz
LIQUID_API_URL=https://api.hyperliquid.xyz/info
LIQUID_MIN_OI_USD=1000000

# Exit returns promotion (2026-Q2): defer early exits; edge lives in 21-40d holds
BACKTEST_HOLD_DAYS=40
BACKTEST_MIN_HOLD_DAYS_BEFORE_TRAIL=15
BACKTEST_MIN_HOLD_DEFER_SOFT_EXITS=true
HOLD_DAYS=40
EXIT_MAX_HOLD_DAYS=40
EXIT_MIN_HOLD_DAYS_BEFORE_TRAIL=15
# Promoted after exit-grace shadow run and explicit operator approval
EXIT_MANAGER_MODE=live

# Signal scoring — composite quality rank v3 (direct volume/signal/miro + safety caps)
SCORE_EDGE_EXCLUDE_52W=true
SCORE_EDGE_SIGNAL_WEIGHT=0.85
SCORE_EDGE_PUP_WEIGHT=0.15
SCORE_EDGE_SIGNAL_WEIGHT=1.0
SCORE_EDGE_PUP_WEIGHT=0.0
SCORE_COMPOSITE_USE_DIRECT_COMPONENTS=true
SCORE_COMPOSITE_DIRECT_TREND_WEIGHT=0.70
SCORE_COMPOSITE_DIRECT_VOLUME_WEIGHT=0.20
SCORE_COMPOSITE_DIRECT_SIGNAL_WEIGHT=0.05
SCORE_COMPOSITE_DIRECT_MIROFISH_WEIGHT=0.05
SCORE_COMPOSITE_STACK_BLEND_WEIGHT=0.0
SCORE_COMPOSITE_SAFETY_CAPS_ONLY=true
SCORE_COMPOSITE_EDGE_WEIGHT=0.0
SCORE_COMPOSITE_RELIABILITY_WEIGHT=0.0
SCORE_COMPOSITE_EXECUTION_WEIGHT=0.0
SCORE_PTS_SMA_CAP=25
SCORE_PTS_SMA_MULTIPLIER=0.0
RANK_SCORE_V2_MODE=shadow
RANK_V2_SIGNAL_WEIGHT=0.35
RANK_V2_VOLUME_WEIGHT=0.50
RANK_V2_MIROFISH_WEIGHT=0.15
RANK_V2_EXCLUDE_52W=true
# Live candidate sort: signal_score until a challenger clears realized-trade validation.
# rank_score_v2 is supported for shadow/backtest parity but is not the default.
SCAN_LIVE_SORT_KEY=signal_score
# Shadow survival readout inside the Rank cell. live is refused (see Stage 2j).
CONFIDENCE_RANK_MODE=shadow
# CONFIDENCE_RANK_ARTIFACT=
# Shadow sort that prefers less-extended names (100 - pts_52w). Does not change
# SCAN_LIVE_SORT_KEY. live is refused until a separate sort-key promotion.
EXTENSION_SORT_MODE=shadow
# PEAD-only shadow mark: close_vs_sma200_pct at or above the frozen book p80.
# Does not remove the row, and does not apply to Stage 2 or entry_family=both.
# live is refused.
PEAD_EXTENSION_DROP_MODE=shadow
# PEAD_EXTENSION_DROP_MIN_SMA200_PCT=0.2028

# Entry intelligence: shadow-only until counterfactual evidence clears promotion
# Checklist grade. shadow attaches qual_raw without changing rank. live is coerced to shadow.
DEBATE_GRADE_MODE=shadow
# Sampled LLM committee on scans only. Writes debate_score beside qual_raw.
# live is coerced to shadow. No-op without an API key. Never runs in the backtest.
DEBATE_COMMITTEE_MODE=shadow
DEBATE_COMMITTEE_MAX_PER_SCAN=3
META_POLICY_MODE=shadow
UNCERTAINTY_MODE=shadow
# High MiroFish disagreement. shadow records mirofish_abstain_would and leaves signal_score unchanged.
# live drops MiroFish points from the score. Default in config is shadow.
# MIROFISH_ABSTAIN_MODE=shadow
# MIROFISH_ABSTAIN_DISAGREEMENT=0.65
CONFLUENCE_GATE_MODE=shadow
QUALITY_GATES_MODE=shadow
# P0 signal-edge shadow counters (never block; see SIGNAL_QUALITY_ROLLOUT.md Stage 2)
SIGNAL_EDGE_SHADOW_MODE=shadow
RANK_FILTER_SHADOW_MIN_PERCENTILE_COMPOSITE=50
RANK_FILTER_SHADOW_MIN_PERCENTILE_RANK_V2=76
RANK_FILTER_V2_MODE=live
RANK_FILTER_SHADOW_MIN_PERCENTILE_SIGNAL=70
STAGE2_SHADOW_52W_PCT=0.88
STAGE2_SHADOW_SMA_UPWARD_DAYS=25
PTS_52W_CAP_MODE=live
PTS_52W_CAP_MAX=37
# PEAD earnings history (not price bars). Finnhub primary; yfinance limit=100 backfill.
# Optional deep history: ALPHA_VANTAGE_API_KEY=... (EARNINGS endpoint)
# PEAD_MIN_HISTORY_ROWS=20
# PEAD_YF_HISTORY_FALLBACK=true
# Sharadar Bundle (PIT universe + dashboard fundamentals/13F/insiders). Research only.
# Direct API key from sharadar.com (x-api-key) — not a Nasdaq Data Link / Quandl token.
# SHARADAR_API_KEY=
# SHARADAR_API_BASE=https://api.sharadar.com/v1.0
# SHARADAR_CACHE_HOURS=12
# PIT_UNIVERSE_PROVIDER=stub  # keep stub until replay_pit_universe_era.py is reviewed
# EARLY_STOP_GATE_MODE=shadow
# BACKTEST_ENTRY_FAMILY=stage2  # stage2 | pullback | pead_primary
# PEAD-primary dual-admit (shadow only; PEAD-only never executable). Default off.
# Offline full SP1500 cleared gate 1A — next step is shadow dual-admit, not live Stage A.
# PEAD canary sleeve (paper top-5; Stage2 remains executable-only):
STRATEGY_PEAD_PRIMARY_MODE=shadow  # off | shadow | live (live coerces to shadow unless ALLOW_LIVE)
STRATEGY_PEAD_PRIMARY_ALLOW_LIVE=false
PEAD_PRIMARY_SHADOW_MAX_NAMES=50  # soft cap; sort: edge_score desc, ticker asc (shadow only)
PEAD_PRIMARY_SHADOW_RANK_TOP_N=5  # capacity arm top5_by_edge_score (canary sleeve)
# PEAD_PRIMARY_LOOKBACK_DAYS=10     # optional; defaults to PEAD_LOOKBACK_DAYS
# Warm earnings before shadow scans (scanner also calls maybe_warm_earnings_for_scan):
# PEAD_ENABLED=true
# PEAD_PRESCAN_WARM_ENABLED=true
# After scan: python scripts/compare_pead_primary_shadow_to_offline.py --write-artifact
# Local ops box (dedicated mini PC). Defaults stay 4 for SaaS/small hosts.
# Diagnose + upsert: python scripts/setup_local_ops_box.py --apply-env
# 8-core UM790 class: A=6 B=6. Do not set these to logical thread count (Schwab 429s).
# SCAN_STAGE_A_MAX_WORKERS=6
# SCAN_STAGE_B_MAX_WORKERS=6
# Per-wave safety cap. A wave that finishes names continues until the universe
# is covered. Two waves that finish nothing checkpoint the remainder.
# SCAN_STAGE_A_MAX_STALLS=2
# SCAN_STAGE_WALL_BUDGET_SEC=1800
# Local dashboard scan hard cap. A live worker stays "running" until this.
# A full SP1500 pass can exceed 90 minutes; 60 minutes marked a healthy scan failed.
# WEB_SCAN_STALE_SECONDS=10800
# SCAN_STAGE_A_CHECKPOINT=true
# P0 entry-timing LIVE (breakout-buffer-only 1%; SMA50 caps off — offline validated)
ENTRY_TIMING_SHADOW_MODE=live
ENTRY_SHADOW_MIN_PCT_ABOVE_SMA50=0.01
ENTRY_SHADOW_MAX_PCT_ABOVE_SMA50=0.25
ENTRY_SHADOW_MIN_BREAKOUT_BUFFER_PCT=0.01
ENTRY_SHADOW_DISABLE_SMA50_FILTERS=true
# Operating stack: live buffer + live exit grace (15/40). Apply with:
#   python scripts/apply_signal_stack_enforced_env.py
#   python scripts/start_local_dashboard.py --signal-stack-enforced
# Clean counterfactual week (demotes entry to shadow + turns off event/exec plugins):
#   python scripts/apply_signal_stack_shadow_env.py
# After scan: python scripts/compare_live_entry_shadow_to_offline.py --write-artifact
# Preflight: python scripts/validate_signal_stack_enforced_env.py
COUNTERFACTUAL_LOGGING_ENABLED=true
# Decision packets: one staged packet per kept scan signal per UTC day.
# Catch up rows missing since the file froze:
#   python scripts/backfill_decision_outcomes.py --since 2026-09-03
# DECISION_PACKET_SCAN_RECORDING_ENABLED=true
# Primary label is 20 trading days. 10 is an early close-to-close signal.
# 40 is the position horizon. Primary and 40 simulate a scale-out
# (half at 2R, rest trailed by 1R). That label does not place orders.
# DECISION_PACKET_HORIZON_DAYS=20
# DECISION_PACKET_EARLY_HORIZON_DAYS=10
# DECISION_PACKET_POSITION_HORIZON_DAYS=40
# DECISION_PACKET_EXIT_MODEL=scale_out
# DECISION_PACKET_SCALE_OUT_FRACTION=0.5
# DECISION_PACKET_SCALE_OUT_TARGET_R=2
# DECISION_PACKET_SCALE_OUT_TRAIL_R=1
# Tab agents share one objective: higher Sortino (or Sharpe) of the 20-day
# scale-out return. Cash is a scored 0% outcome. Long-only: no shorts or options.
# A book is blocked only when max drawdown is deeper than 20% (configurable, floor 20%).
# Do not penalize market cap. Liquidity is average dollar volume and spread.
# Agents may retune those thresholds and the quality threshold only inside the bounds.
# TAB_AGENT_DEBATE_MAX_NAMES=0 means no name cap. There is no top-N.
# Shadow auto-promotes when it beats live AND a reviewer approves, or when no
# verdict file arrives within 48h. Verdict file:
#   .tab_agent_reviews/<tab>-<version>.verdict.json
#   {"verdict":"approve"|"reject","notes":"...","reviewer":"quant"}
# Request file written for every proposal:
#   .tab_agent_reviews/<tab>-<version>.json
# Weekday 16:00 ET governs and writes .tab_agent_digest/YYYY-MM-DD.md and .json.
# Sunday 18:20 ET proposes a shadow candidate. Manual approve/rollback remain overrides.
# TAB_AGENT_OBJECTIVE=sortino
# TAB_AGENT_MIN_SAMPLES=30
# TAB_AGENT_DRAWDOWN_TOLERANCE=0.20
# TAB_AGENT_MIN_AVG_DOLLAR_VOLUME=20000000
# TAB_AGENT_MAX_SPREAD_PCT=0.01
# TAB_AGENT_MIN_AVG_DOLLAR_VOLUME_MIN=5000000
# TAB_AGENT_MIN_AVG_DOLLAR_VOLUME_MAX=100000000
# TAB_AGENT_MAX_SPREAD_PCT_MIN=0.002
# TAB_AGENT_MAX_SPREAD_PCT_MAX=0.03
# TAB_AGENT_QUALITY_THRESHOLD=60
# TAB_AGENT_QUALITY_THRESHOLD_MIN=40
# TAB_AGENT_QUALITY_THRESHOLD_MAX=90
# TAB_AGENT_DEBATE_MAX_NAMES=0
# TAB_AGENT_REVIEW_WAIT_HOURS=48
# TAB_AGENT_TODAY_ENABLED=true
# TAB_AGENT_SHADOW_ENABLED=true
# Debate committee prompts use the same objective. Default on. Shadow candidates
# do not change qual_raw or signal_score. Sunday 18:25 ET proposes; 16:00 ET governs.
# TAB_AGENT_DEBATE_ENABLED=true
# TAB_AGENT_DEBATE_SHADOW_ENABLED=true
# TAB_AGENT_DEBATE_MAX_NAMES=0 keeps every name that clears the quality threshold.
# Book YTD Excel export (Portfolio → Book). Canonical file under exports/; EOD via bot loop.
# BOOK_YTD_EXPORT_ENABLED=true
# BOOK_YTD_EXPORT_HHMM=16:30
# BOOK_YTD_EXPORT_PATH=exports/book_ytd_{year}.xlsx

# Multi-sleeve constitution (wiki/multi-sleeve-trading-system-constitution.md)
# RTH evidence week (allocator shadow + ledger). Apply with:
#   python scripts/apply_multi_sleeve_rth_shadow_env.py
#   python scripts/validate_multi_sleeve_rth_shadow_env.py
# ALLOCATOR_MODE=shadow
# MULTI_SLEEVE_S1_LIVE=false
# MULTI_SLEEVE_S1_PROMOTED_CAP=false
# HYPOTHESIS_LEDGER_ENABLED=true
# HYPOTHESIS_SELF_STUDY_MERGE=true
# Experiment harvest after scans. Unset defaults on. false stops harvest and the 16:15 brief.
# EXPERIMENT_COLLECTOR_ENABLED=true
# HYPOTHESIS_SCORE_HORIZONS=1,5,20
# R7_PROMOTION_MIN_N=40
# R7_PRIMARY_HORIZON=5
# R3_CAPACITY_SHADOW=false
# R6_VOL_DAMPER_ENABLED=false
